# Ad Tag Tracker — environment variables
# Copy to .env (for local dev) or to the EC2 instance .env (for production).

# --- Server ---
NODE_ENV=production
PORT=5000

# --- Database ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://adtag:CHANGE_ME@localhost:5432/adtag

# --- Sessions (REQUIRED in production — app will exit if unset) ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_TO_64_HEX_CHARS

# --- Portal SSO (REQUIRED) ---
# Shared HMAC secret used to verify SSO tickets issued by the Internal Portal.
# Must exactly match SSO_SECRET_AD_TAG_TRACKER in the Portal backend's env.
# Generate with: openssl rand -hex 32
SSO_SECRET_AD_TAG_TRACKER=CHANGE_ME_TO_64_HEX_CHARS

# --- Brevo (transactional email) ---
# Non-auth product notifications only (tag-change alerts, scan-failure alerts,
# monthly reports). Sign up at https://www.brevo.com, verify your sender, then
# paste the API key. If BREVO_API_KEY is empty, emails are logged to the console
# instead of sent.
BREVO_API_KEY=
BREVO_FROM=Ad Tag Tracker <noreply@rallyadmedia.com>

# --- Public-facing URL (REQUIRED in production) ---
# Used in notification email links. MUST be HTTPS in production so SSO tickets
# are never transmitted over plaintext.
APP_URL=https://your-domain.com

# --- Internal Portal URL (optional) ---
# Powers the "Back to Portal" sidebar link and the signed-out screen. When
# unset, both are simply hidden. Exposed to the client bundle at build time.
VITE_PORTAL_URL=https://portal.rallyadmedia.com

# --- Admin bootstrap (only used on first boot, when no admin profile exists) ---
# Seeds a local admin PROFILE (no password). The account signs in via the
# Internal Portal; this row links by email on first SSO login.
ADMIN_EMAIL=Lucan@rallyad.com
ADMIN_NAME=Lucan Marsh
