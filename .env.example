# Ad Tag Tracker — environment variables
# Copy to .env (for local dev) or to the EC2 instance .env (for production).

# --- Server ---
NODE_ENV=production
PORT=5000

# --- Database ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://adtag:CHANGE_ME@localhost:5432/adtag

# --- Sessions (REQUIRED in production — app will exit if unset) ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_TO_64_HEX_CHARS

# --- Resend (transactional email) ---
# Sign up at https://resend.com, verify your sending domain, then paste the API key.
# If RESEND_API_KEY is empty, emails will only be logged to the console.
RESEND_API_KEY=
RESEND_FROM=Ad Tag Tracker <noreply@mail.yourdomain.com>

# --- Public-facing URL (REQUIRED in production) ---
# Used in invitation, password-reset, and report email links.
APP_URL=https://your-domain.com

# --- Admin bootstrap (only used on first boot, when no admin exists) ---
# After the admin is created, its email is locked in. To use a different one,
# delete the user from the DB and restart.
ADMIN_EMAIL=Lucan@rallyad.com
ADMIN_NAME=Lucan Marsh
